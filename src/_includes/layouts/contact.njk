---
layout: layouts/base.njk
---
<div style="max-width: var(--max-width); margin: 0 auto;">
  <header style="margin-bottom: 4rem; text-align: center;">
    <h1 style="text-transform: uppercase; letter-spacing: 0.05em; font-family: var(--font-serif);">Get In Touch</h1>
    <p class="hero-subtitle" style="font-size: 1.2rem; margin-top: 1rem; color: var(--accent); font-style: italic;">
      Inquiries, studio visits, and print commissions.
    </p>
  </header>

  <div class="contact-container">
    
    <!-- Left Column: Contact Info -->
    <div class="contact-info">
      <h3>Ars Photographica Studio</h3>
      <p style="margin-bottom: 2rem;">
        For general questions, print acquisition requests, or to arrange a private viewing at the studio in Zurich, please fill out the form or reach out directly.
      </p>
      
      <ul class="contact-details">
        <li>
          <span>Direct Email</span>
          <span><a href="mailto:{{ site.email }}" style="color: var(--accent);">{{ site.email }}</a></span>
        </li>
        <li>
          <span>Instagram</span>
          <span><a href="{{ site.instagram }}" target="_blank" rel="noopener" style="color: var(--accent);">@arsphotographica</a></span>
        </li>
        {% if site.bluesky %}
        <li>
          <span>Bluesky</span>
          <span><a href="{{ site.bluesky }}" target="_blank" rel="noopener" style="color: var(--accent);">@arsphotographica.ch</a></span>
        </li>
        {% endif %}
        {% if site.kofi %}
        <li>
          <span>Ko-fi Shop</span>
          <span><a href="{{ site.kofi }}" target="_blank" rel="noopener" style="color: var(--accent);">ko-fi.com/arsphotographica</a></span>
        </li>
        {% endif %}
      </ul>

      <div style="background: var(--bg-secondary); border: 1px solid var(--border-color); padding: 1.5rem; border-radius: 4px; margin-top: 2rem;">
        <h4 style="font-family: var(--font-sans); font-weight: 600; font-size: 0.9rem; text-transform: uppercase; letter-spacing: 0.05em; color: var(--text-primary); margin-bottom: 0.5rem;">
          Studio Visits
        </h4>
        <p style="font-size: 0.9rem; margin-bottom: 0; color: var(--text-secondary);">
          Visits are available by appointment only. Please contact us at least 48 hours in advance to arrange a viewing of specific prints or series portfolios.
        </p>
      </div>
    </div>

    <!-- Right Column: Inquiry Form -->
    <div class="contact-form">
      <form id="inquiry-form" action="https://formspree.io/f/mqevgkyk" method="POST">
        <div class="form-group">
          <label for="name">Your Name</label>
          <input type="text" id="name" name="name" placeholder="John Doe" required>
        </div>

        <div class="form-group">
          <label for="email">Email Address</label>
          <input type="email" id="email" name="email" placeholder="john@example.com" required>
        </div>

        <div class="form-group">
          <label for="subject">Subject</label>
          <input type="text" id="subject" name="subject" placeholder="General Inquiry" required>
        </div>

        <div class="form-group">
          <label for="message">Message</label>
          <textarea id="message" name="message" placeholder="How can we help you?" required></textarea>
        </div>

        <div id="form-status" style="margin-top: 1rem; display: none; padding: 1rem; border-radius: 4px; font-size: 0.95rem; line-height: 1.5;"></div>

        <button type="submit" id="submit-btn" class="btn btn-primary" style="margin-top: 1rem;">Send Inquiry</button>
      </form>
    </div>

  </div>
</div>

<!-- Script to handle Print Acquisition Autofill and Formspree submission -->
<script>
  document.addEventListener('DOMContentLoaded', () => {
    // 1. Handle Print Acquisition Autofill from query parameters
    const params = new URLSearchParams(window.location.search);
    const printTitle = params.get('print');
    
    if (printTitle) {
      const subjectInput = document.getElementById('subject');
      const messageTextarea = document.getElementById('message');
      
      if (subjectInput) {
        subjectInput.value = `Acquisition Inquiry: "${printTitle}"`;
      }
      
      if (messageTextarea) {
        messageTextarea.value = `Dear Ars Photographica,\n\nI am interested in acquiring a limited edition fine art print of "${printTitle}". \n\nPlease let me know if this work is currently available in the edition, and provide details regarding packaging, shipping costs to my location, and framing options. \n\nBest regards,`;
      }
    }

    // 2. Handle Formspree AJAX Submission with mailto Fallback
    const form = document.getElementById('inquiry-form');
    const status = document.getElementById('form-status');
    const submitBtn = document.getElementById('submit-btn');

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      
      // Update UI to loading state
      submitBtn.disabled = true;
      const originalText = submitBtn.textContent;
      submitBtn.textContent = 'Sending...';
      
      status.style.display = 'none';
      status.className = '';
      status.textContent = '';

      const data = new FormData(form);

      try {
        const response = await fetch(form.action, {
          method: form.method,
          body: data,
          headers: {
            'Accept': 'application/json'
          }
        });

        if (response.ok) {
          // Success
          status.style.display = 'block';
          status.style.background = 'rgba(16, 185, 129, 0.08)';
          status.style.border = '1px solid rgba(16, 185, 129, 0.2)';
          status.style.color = '#10b981';
          status.textContent = 'Thank you! Your inquiry has been sent successfully.';
          form.reset();
          submitBtn.textContent = originalText;
          submitBtn.disabled = false;
        } else {
          // Error response from server
          const responseData = await response.json();
          if (responseData.errors && responseData.errors.length > 0) {
            throw new Error(responseData.errors.map(err => err.message).join(', '));
          } else {
            throw new Error('Form submission failed.');
          }
        }
      } catch (error) {
        // Fallback to mailto
        console.warn('AJAX submit failed, falling back to mailto client:', error);
        
        status.style.display = 'block';
        status.style.background = 'rgba(212, 175, 55, 0.08)';
        status.style.border = '1px solid rgba(212, 175, 55, 0.2)';
        status.style.color = 'var(--accent)';
        status.textContent = 'Connection busy. Launching your email client to send message...';

        setTimeout(() => {
          const name = document.getElementById('name').value;
          const email = document.getElementById('email').value;
          const subject = document.getElementById('subject').value;
          const message = document.getElementById('message').value;
          
          const mailtoBody = `Name: ${name}\nEmail: ${email}\n\nMessage:\n${message}`;
          const mailtoUrl = `mailto:{{ site.email }}?subject=${encodeURIComponent(subject)}&body=${encodeURIComponent(mailtoBody)}`;
          
          window.location.href = mailtoUrl;

          // Reset button state
          submitBtn.textContent = originalText;
          submitBtn.disabled = false;
        }, 1200);
      }
    });
  });
</script>
